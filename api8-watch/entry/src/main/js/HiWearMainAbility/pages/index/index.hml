<div class="app" @swipe="handleSwipe" @touchstart="onRootTouchStart" @touchend="onRootTouchEnd" @touchcancel="onRootTouchCancel">
  <button id="hardwareKeySink" class="hardware-key-sink" focusable="true" onkey="handleHardwareKey"></button>
  <div if="{{mainVisible && pageIndex === 0}}" class="page home-page">
    <div class="home-sky"></div>
    <image class="home-orb" src="/common/brand/chatgpt-orb.png"></image>
    <text class="home-wordmark">ChatGPT</text>
    <div if="{{codexTaskId && codexStatus !== 'succeeded' && codexStatus !== 'failed' && codexStatus !== 'cancelled'}}" class="home-task" @click="openLatestCodexTask">
      <text class="home-task-dot">●</text>
      <text class="home-task-text">Codex 任务 · {{codexStage}}</text>
    </div>
    <div class="home-actions">
      <div class="hero-action hero-chat" @click="startVoice">
        <div class="hero-glint"></div>
        <image class="hero-icon" src="/common/interface-icons/chat-white.png"></image>
        <text class="hero-label">开始对话</text>
      </div>
      <div class="hero-action hero-record" @click="startRecordingFromHome">
        <div class="hero-glint"></div>
        <image class="hero-icon" src="/common/interface-icons/waveform-white.png"></image>
        <text class="hero-label">录音摘要</text>
      </div>
    </div>
    <div class="page-dots">
      <div class="page-dot dot-active"></div>
      <div class="page-dot"></div>
      <div class="page-dot"></div>
      <div class="page-dot"></div>
    </div>
  </div>

  <div if="{{mainVisible && pageIndex === 1}}" class="page record-page">
    <text class="page-title">录音摘要</text>
    <div class="record-stage">
      <div class="record-wavebox {{recordPaused ? 'record-wave-paused' : ''}}">
        <div class="wave-bar" for="{{recordWaveBars}}" style="height: {{$item.height}}px; animation-duration: {{$item.duration}}s; animation-delay: {{$item.delay}}s;"></div>
      </div>
      <div class="record-ring {{recordRunning ? 'record-ring-recording' : (recordPaused ? 'record-ring-paused' : '')}}" @click="toggleRecording">
        <image class="record-wave-icon" src="/common/interface-icons/waveform-white.png"></image>
        <text class="record-time">{{recordTimer}}</text>
        <text class="record-state">{{recordStatus}}</text>
      </div>
    </div>
    <div if="{{!recordHasProgress}}" class="record-start-wrap">
      <div class="primary-pill record-start" @click="startRecording">
        <text class="pill-label">开始录音</text>
      </div>
    </div>
    <div if="{{recordHasProgress && !recordSubmitting}}" class="record-actions">
      <div class="round-action" @click="toggleRecording">
        <div class="round-disc pause-disc">
          <image class="round-icon" src="/common/interface-icons/{{recordRunning ? 'pause-cyan' : 'waveform-white'}}.png"></image>
        </div>
        <text class="round-label">{{recordRunning ? '暂停' : '继续'}}</text>
      </div>
      <div class="round-action" @click="markRecording">
        <div class="round-disc mark-disc">
          <image class="round-icon" src="/common/interface-icons/bookmark-cyan.png"></image>
        </div>
        <text class="round-label">标记</text>
      </div>
      <div class="round-action" @click="finishRecording">
        <div class="round-disc end-disc">
          <image class="round-icon" src="/common/interface-icons/stop-red.png"></image>
        </div>
        <text class="round-label">结束</text>
      </div>
    </div>
    <div class="page-dots">
      <div class="page-dot"></div>
      <div class="page-dot dot-active"></div>
      <div class="page-dot"></div>
      <div class="page-dot"></div>
    </div>
  </div>

  <div if="{{mainVisible && pageIndex === 2}}" class="page history-page">
    <text class="fixed-page-title">最近</text>
    <list id="recentList" itemscale="false" itemcenter="false" shapemode="round" class="wrist-list" @scrolltop="mainListReachedStart" @scrollbottom="mainListReachedEnd">
      <list-item class="list-item" @click="newChat">
        <div class="glass-row row-inner new-chat-row">
          <div class="row-icon-box"><image class="row-icon-img" src="/common/interface-icons/chat-blue.png"></image></div>
          <div class="row-copy">
            <text class="row-label">新建文字对话</text>
            <text class="row-subtitle">内置模型</text>
          </div>
          <text class="row-chevron">›</text>
        </div>
      </list-item>
      <list-item class="list-item" for="{{taskHistory}}" @click="openCodexTask($item)">
        <div class="glass-row row-inner">
          <div class="row-icon-box"><image class="row-icon-img" src="/common/interface-icons/terminal-cyan.png"></image></div>
          <div class="row-copy">
            <text class="row-label">{{$item.title}}</text>
            <text class="row-subtitle">{{$item.subtitle}}</text>
          </div>
          <text class="row-badge {{$item.status === 'succeeded' ? 'row-badge-complete' : ''}}">{{$item.status === 'succeeded' ? '完成' : ($item.status === 'failed' ? '失败' : ($item.status === 'cancelled' ? '停止' : '执行中'))}}</text>
        </div>
      </list-item>
      <list-item class="list-item" for="{{recentThreads}}" @click="openThread($item)">
        <div class="glass-row row-inner">
          <div class="row-icon-box"><image class="row-icon-img" src="/common/interface-icons/chat-blue.png"></image></div>
          <div class="row-copy">
            <text class="row-label">{{$item.title}}</text>
            <text class="row-subtitle">{{$item.messages.length}} 条消息</text>
          </div>
          <text class="row-chevron">›</text>
        </div>
      </list-item>
      <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
    </list>
    <div class="page-dots">
      <div class="page-dot"></div>
      <div class="page-dot"></div>
      <div class="page-dot dot-active"></div>
      <div class="page-dot"></div>
    </div>
  </div>

  <div if="{{mainVisible && pageIndex === 3}}" class="page settings-page">
    <text class="fixed-page-title">设置</text>
    <text class="settings-note">始终静音 · 不影响睡眠</text>
    <list id="settingsList" itemscale="false" itemcenter="false" shapemode="round" class="wrist-list" @scrolltop="mainListReachedStart" @scrollbottom="mainListReachedEnd">
      <list-item class="list-item" @click="toggleHaptics">
        <div class="glass-row row-inner">
          <div class="row-icon-box"><image class="row-icon-img" src="/common/interface-icons/brain-teal.png"></image></div>
          <div class="row-copy">
            <text class="row-label">触感反馈</text>
            <text class="row-subtitle">{{hapticsEnabled ? '开启' : '关闭'}}</text>
          </div>
          <div class="switch-track" style="background-color: {{hapticsEnabled ? '#167f8d' : '#26343a'}};">
            <div class="switch-knob" style="margin-left: {{hapticsEnabled ? 28 : 0}}px;"></div>
          </div>
        </div>
      </list-item>
      <list-item class="list-item" @click="openRoundInterface">
        <div class="glass-row row-inner">
          <div class="row-icon-box"><image class="row-icon-img" src="/common/interface-icons/sparkle-cyan.png"></image></div>
          <div class="row-copy">
            <text class="row-label">界面风格</text>
            <text class="row-subtitle">经典与圆环双主题</text>
          </div>
          <text class="row-badge">切换</text>
        </div>
      </list-item>
      <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
    </list>
    <div class="page-dots">
      <div class="page-dot"></div>
      <div class="page-dot"></div>
      <div class="page-dot"></div>
      <div class="page-dot dot-active"></div>
    </div>
  </div>

  <div if="{{subPage === 'voice'}}" class="subpage voice-page">
    <div class="voice-ring-wrap"
      @touchstart="startVoicePress"
      @touchmove="onVoiceTouchMove"
      @touchend="onVoiceTouchEnd"
      @touchcancel="onVoiceTouchCancel">
      <div class="voice-ring-halo"></div>
      <div class="voice-ring-outer"></div>
      <div class="voice-ring-mid"></div>
      <div class="voice-core">
        <div class="voice-core-glint"></div>
        <image class="voice-mic" src="/common/control-icons/mic.png"></image>
        <text class="voice-cta">{{voiceCta}}</text>
      </div>
    </div>
    <div class="voice-live">
      <text class="voice-live-dot">●</text>
      <text class="voice-live-text">{{voiceStatus}}</text>
    </div>
    <div class="voice-hub">
      <div class="voice-hub-row" @click="openRecordFromVoice">
        <div class="hub-icon-box"><image class="hub-icon" src="/common/interface-icons/file-blue.png"></image></div>
        <div class="hub-copy">
          <text class="hub-title">录音摘要</text>
          <text class="hub-subtitle">会议录音 · 自动摘要</text>
        </div>
        <text class="row-chevron">›</text>
      </div>
      <div class="voice-hub-row" @click="openTextChatFromVoice">
        <div class="hub-icon-box"><image class="hub-icon" src="/common/interface-icons/chat-blue.png"></image></div>
        <div class="hub-copy">
          <text class="hub-title">文字对话</text>
            <text class="hub-subtitle">继续输入 · 内置模型</text>
        </div>
        <text class="row-chevron">›</text>
      </div>
    </div>
    <div if="{{voiceResponseText}}" class="voice-error-card">
      <text class="voice-error-text">{{voiceResponseText}}</text>
    </div>
  </div>

  <div if="{{subPage === 'answer'}}" class="subpage answer-page">
    <text class="page-title">语音回答</text>
    <list itemscale="false" itemcenter="false" class="answer-scroll">
      <list-item class="answer-item">
        <div class="answer-user-card">
          <text class="answer-author">你</text>
          <text class="answer-user-text">{{voiceTranscriptText || '（未返回识别文本）'}}</text>
        </div>
      </list-item>
      <list-item class="answer-item">
        <div class="answer-assistant-card">
          <div class="answer-heading">
            <image class="answer-logo" src="/common/interface-icons/openai-white.png"></image>
            <text class="answer-author">ChatGPT</text>
          </div>
          <text class="answer-assistant-text">{{voiceAnswerText || voiceResponseText}}</text>
        </div>
      </list-item>
      <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
    </list>
    <div class="answer-actions">
      <div class="secondary-pill" @click="copyVoiceAnswer">
        <image class="button-icon" src="/common/interface-icons/copy-white.png"></image>
        <text class="pill-label">复制</text>
      </div>
      <div class="primary-pill" @click="continueVoiceChat">
        <image class="button-icon" src="/common/interface-icons/chat-white.png"></image>
        <text class="pill-label">继续追问</text>
      </div>
    </div>
  </div>

  <div if="{{subPage === 'task'}}" class="subpage task-page">
    <text class="page-title">Codex 任务</text>
    <div class="task-orbit">
      <div class="orbit-halo"></div>
      <div class="orbit-dash"></div>
      <div class="task-core">
        <image class="task-icon" src="/common/interface-icons/terminal-cyan.png"></image>
      </div>
    </div>
    <text class="task-stage">{{codexStage}}</text>
    <text class="task-message">{{codexMessage}} · {{codexElapsedText}}</text>
    <div class="task-card">
      <text class="task-card-text">{{codexTranscript || '正在转写语音…'}}</text>
    </div>
    <div
      if="{{codexStatus !== 'succeeded' && codexStatus !== 'failed' && codexStatus !== 'cancelled'}}"
      class="danger-pill task-stop"
      @click="cancelCodexTask">
      <image class="button-icon" src="/common/interface-icons/stop-red.png"></image>
      <text class="pill-label">停止任务</text>
    </div>
  </div>

  <div if="{{subPage === 'result'}}" class="subpage result-page">
    <text class="page-title">任务结果</text>
    <div class="segmented-control">
      <div class="segment-indicator {{resultTab === 'summary' ? 'segment-right' : 'segment-left'}}"></div>
      <div class="segment-option" @click="showTranscript">
        <text class="segment-label" style="color: {{resultTab === 'transcript' ? '#f2ffff' : '#8d9ba2'}};">转写</text>
      </div>
      <div class="segment-option" @click="showSummary">
        <text class="segment-label" style="color: {{resultTab === 'summary' ? '#f2ffff' : '#8d9ba2'}};">摘要</text>
      </div>
    </div>
    <list itemscale="false" itemcenter="false" class="result-scroll">
      <block if="{{resultTab === 'summary'}}">
        <list-item class="result-list-item" for="{{summaryItems}}">
          <div class="result-point">
            <div class="result-index"><text class="result-index-text">{{$idx + 1}}</text></div>
            <text class="result-point-text">{{$item}}</text>
          </div>
        </list-item>
      </block>
      <block if="{{resultTab === 'transcript'}}">
        <list-item class="result-list-item">
          <div class="transcript-card">
            <text class="transcript-text">{{codexFinalText || 'Codex 未返回文字结果'}}</text>
          </div>
        </list-item>
      </block>
      <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
    </list>
    <div class="result-actions">
      <div class="secondary-pill" @click="copyResult">
        <image class="button-icon" src="/common/interface-icons/copy-white.png"></image>
        <text class="pill-label">复制</text>
      </div>
      <div class="primary-pill" @click="continueFromResult">
        <image class="button-icon" src="/common/interface-icons/chat-white.png"></image>
        <text class="pill-label">继续追问</text>
      </div>
    </div>
  </div>

  <div if="{{subPage === 'chat'}}" class="subpage conversation-page">
    <text class="page-title chat-title">{{chatTitle}}</text>
    <list itemscale="false" itemcenter="false" class="chat-scroll">
      <list-item class="chat-item" for="{{visibleChatMessages}}">
        <div class="message-row {{$item.role === 'user' ? 'message-user' : 'message-assistant'}}">
          <text class="message-author">{{$item.role === 'user' ? '你' : 'ChatGPT'}}</text>
          <text class="message-text">{{$item.text}}</text>
        </div>
      </list-item>
      <list-item if="{{visibleChatMessages.length === 0}}" class="chat-item">
        <text class="chat-empty">输入一句话，或返回语音页直接说话。</text>
      </list-item>
      <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
    </list>
    <div class="chat-composer">
      <input class="chat-input" value="{{chatInput}}" placeholder="输入消息" @change="onChatInput" />
      <div class="chat-send" @click="sendChat">
        <image class="send-icon" src="/common/interface-icons/paperplane-white.png"></image>
      </div>
    </div>
  </div>

  <div if="{{subPage === 'result' || subPage === 'chat' || subPage === 'task' || (mainVisible && pageIndex >= 2)}}" class="round-bottom-shade"></div>

  <div if="{{toastVisible}}" class="toast">
    <text class="toast-text">{{toastText}}</text>
  </div>
</div>
