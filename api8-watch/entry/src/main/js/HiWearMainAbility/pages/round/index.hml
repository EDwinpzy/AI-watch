<div class="app" @swipe="handleSwipe" @touchstart="onRootTouchStart">
  <div if="{{mainVisible}}" class="main-shell">
    <div if="{{pageIndex === 0}}" class="page watch-face">
      <div class="face-head">
        <text class="face-date">{{dateText}}</text>
        <text class="face-time">{{clockText}}</text>
      </div>

      <div class="hero-complication" @click="startVoiceChat">
        <div class="activity-ring ring-red"></div>
        <div class="activity-ring ring-orange"></div>
        <div class="activity-ring ring-green"></div>
        <div class="hero-core">
          <text class="hero-mark">✦</text>
          <text class="hero-label">NOVA AI</text>
          <text class="hero-action">开始对话</text>
        </div>
      </div>

      <div class="home-actions">
        <div class="home-action action-chat" @click="openQuickChat">
          <image class="home-action-icon" src="/common/interface-icons/chat-white.png"></image>
          <text class="home-action-label">文字对话</text>
        </div>
        <div class="home-action action-record" @click="startRecordingFromHome">
          <image class="home-action-icon" src="/common/interface-icons/waveform-white.png"></image>
          <text class="home-action-label">录音摘要</text>
        </div>
      </div>

      <div class="page-dots">
        <div class="page-dot dot-active"></div>
        <div class="page-dot"></div>
        <div class="page-dot"></div>
        <div class="page-dot"></div>
      </div>
    </div>

    <div if="{{pageIndex === 1}}" class="page record-page">
      <text class="fixed-page-title">录音摘要</text>
      <div if="{{recordHasProgress}}" class="record-wave-strip {{recordPaused ? 'record-wave-paused' : ''}}">
        <div
          class="record-wave-bar"
          for="{{recordWaveBars}}"
          style="height: {{$item.height}}px; animation-duration: {{$item.duration}}s; animation-delay: {{$item.delay}}s;">
        </div>
      </div>
      <div class="record-dial" @click="toggleRecording">
        <div class="record-ring record-ring-red {{recordRunning ? 'record-ring-live' : ''}}"></div>
        <div class="record-ring record-ring-orange {{recordRunning ? 'record-ring-live' : ''}}"></div>
        <div class="record-core">
          <text class="timer-label">{{recordPaused ? '已暂停' : (recordRunning ? '正在录音' : 'NOVA MEMO')}}</text>
          <text class="record-clock">{{recordTimer}}</text>
          <image class="record-wave-icon" src="/common/interface-icons/waveform-white.png"></image>
          <text class="record-caption">{{recordRunning ? '输入 ' + recordInputLevel + '%' : '点按控制录音'}}</text>
        </div>
      </div>
      <text class="record-note">{{recordHasProgress ? recordStatus : '录音结束后自动转写并创建只读 Codex 任务'}}</text>

      <div if="{{!recordHasProgress}}" class="record-start-wrap">
        <div class="record-start-pill" @click="startRecording">
          <image class="button-icon" src="/common/interface-icons/waveform-white.png"></image>
          <text class="pill-label">开始录音</text>
        </div>
      </div>

      <div if="{{recordHasProgress}}" class="record-actions">
        <div class="record-action" @click="toggleRecording">
          <div class="record-action-disc action-pause">
            <image class="record-action-icon" src="/common/interface-icons/{{recordRunning ? 'pause-cyan' : 'waveform-white'}}.png"></image>
          </div>
          <text class="record-action-label">{{recordRunning ? '暂停' : '继续'}}</text>
        </div>
        <div class="record-action" @click="markRecording">
          <div class="record-action-disc action-mark">
            <image class="record-action-icon" src="/common/interface-icons/bookmark-cyan.png"></image>
          </div>
          <text class="record-action-label">标记</text>
        </div>
        <div class="record-action" @click="finishRecording">
          <div class="record-action-disc action-finish">
            <image class="record-action-icon" src="/common/interface-icons/stop-red.png"></image>
          </div>
          <text class="record-action-label">结束</text>
        </div>
      </div>
      <div class="page-dots">
        <div class="page-dot"></div>
        <div class="page-dot dot-active"></div>
        <div class="page-dot"></div>
        <div class="page-dot"></div>
      </div>
    </div>

    <div if="{{pageIndex === 2}}" class="page history-page">
      <text class="fixed-page-title">最近</text>
      <list itemscale="false" itemcenter="false" shapemode="round" class="wrist-list" @scrolltop="mainListReachedStart" @scrollbottom="mainListReachedEnd">
        <list-item class="list-item" @click="newChat">
          <div class="row-shell new-chat-shell">
            <div class="row-mark row-mark-blue"><text class="row-mark-text">＋</text></div>
            <div class="row-copy">
              <text class="row-label">新建对话</text>
              <text class="row-subtitle">文字或语音开始</text>
            </div>
          </div>
        </list-item>
        <list-item class="list-item" for="{{taskHistory}}" @click="openCodexTask($item)">
          <div class="row-shell task-row">
            <div class="row-mark row-mark-cyan">
              <image class="row-mark-icon" src="/common/interface-icons/terminal-cyan.png"></image>
            </div>
            <div class="row-copy task-row-copy">
              <text class="row-label">{{$item.title}}</text>
              <text class="row-subtitle">{{$item.subtitle}}</text>
            </div>
            <text class="task-status-chip {{$item.statusClass}}">{{$item.statusLabel}}</text>
          </div>
        </list-item>
        <list-item class="list-item" for="{{threads}}" @click="openThread($item)">
          <div class="row-shell">
            <div class="row-mark"><text class="row-mark-text">{{$item.mark}}</text></div>
            <div class="row-copy">
              <text class="row-label">{{$item.title}}</text>
              <text class="row-subtitle">{{$item.preview}}</text>
            </div>
            <text class="row-chevron">›</text>
          </div>
        </list-item>
        <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
      </list>
      <div class="page-dots">
        <div class="page-dot"></div>
        <div class="page-dot"></div>
        <div class="page-dot dot-active"></div>
        <div class="page-dot"></div>
      </div>
    </div>

    <div if="{{pageIndex === 3}}" class="page settings-page">
      <text class="fixed-page-title">设置</text>
      <list itemscale="false" itemcenter="false" shapemode="round" class="wrist-list" @scrolltop="mainListReachedStart" @scrollbottom="mainListReachedEnd">
        <list-item class="list-item">
          <div class="row-shell compact-row">
            <div class="row-mark row-mark-green"><text class="row-mark-text">✓</text></div>
            <div class="row-copy">
              <text class="row-label">始终静音</text>
              <text class="row-subtitle">不播放声音，不影响睡眠</text>
            </div>
          </div>
        </list-item>
        <list-item class="list-item" @click="toggleHaptics">
          <div class="row-shell compact-row">
            <div class="row-mark row-mark-green"><text class="row-mark-text">≈</text></div>
            <div class="row-copy">
              <text class="row-label">触感反馈</text>
              <text class="row-subtitle">{{hapticsEnabled ? '轻触状态反馈 · 已开启' : '轻触状态反馈 · 已关闭'}}</text>
            </div>
            <div class="switch-track {{hapticsEnabled ? 'switch-on' : ''}}">
              <div class="switch-knob {{hapticsEnabled ? 'switch-knob-on' : ''}}"></div>
            </div>
          </div>
        </list-item>
        <list-item class="list-item" @click="switchToClassicInterface">
          <div class="row-shell compact-row">
            <div class="row-mark row-mark-blue"><text class="row-mark-text">Aa</text></div>
            <div class="row-copy">
              <text class="row-label">界面风格</text>
              <text class="row-subtitle">Apple Watch 圆环 · 点击返回经典界面</text>
            </div>
            <text class="row-chevron">›</text>
          </div>
        </list-item>
        <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
      </list>
      <div class="page-dots">
        <div class="page-dot"></div>
        <div class="page-dot"></div>
        <div class="page-dot"></div>
        <div class="page-dot dot-active"></div>
      </div>
    </div>
  </div>

  <div if="{{subPage === 'chat'}}" class="subpage conversation-page">
    <text class="fixed-page-title chat-title">{{chatTitle}}</text>
    <div class="chat-mode-chip">
      <text class="chat-mode-dot"></text>
      <text class="chat-mode-text">内置 AI · {{builtInModel}}</text>
    </div>
    <div if="{{voicePhase !== 'idle'}}" class="voice-state">
      <div class="voice-state-dot {{voicePhase === 'listening' ? 'voice-state-live' : ''}}"></div>
      <text class="voice-state-text">{{voiceStatusText}}</text>
      <text if="{{voicePhase === 'listening'}}" class="voice-state-timer">{{voiceTimer}}</text>
    </div>
    <list itemscale="false" itemcenter="false" class="chat-scroll">
      <list-item class="chat-item" for="{{chatMessages}}">
        <div class="message-row {{$item.role === 'user' ? 'message-user' : 'message-assistant'}}">
          <text class="message-author">{{$item.role === 'user' ? 'YOU' : 'NOVA'}}</text>
          <text class="message-text">{{$item.text}}</text>
        </div>
      </list-item>
      <list-item if="{{chatMessages.length === 0}}" class="chat-item">
        <div class="chat-empty-card">
          <text class="chat-empty-mark">✦</text>
          <text class="chat-empty">输入一句话开始</text>
        </div>
      </list-item>
      <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
    </list>
    <div class="composer">
      <input class="composer-input" type="text" value="{{chatInput}}" placeholder="{{composerPlaceholder}}" @change="onChatInput" />
      <div class="voice-button {{voicePhase === 'listening' ? 'voice-button-live' : (voicePhase === 'speaking' ? 'voice-button-speaking' : '')}}" @click="toggleVoiceInput">
        <div if="{{voicePhase === 'listening'}}" class="record-stop-glyph"></div>
        <text if="{{voicePhase === 'requesting' || voicePhase === 'transcribing' || voicePhase === 'thinking'}}" class="voice-busy-label">…</text>
        <div if="{{voicePhase === 'idle' || voicePhase === 'speaking' || voicePhase === 'error'}}" class="mic-glyph">
          <div class="mic-capsule"></div>
          <div class="mic-cradle"></div>
          <div class="mic-stem"></div>
          <div class="mic-base"></div>
        </div>
      </div>
      <div class="send-button {{chatRequestPending ? 'send-disabled' : ''}}" @click="sendChat">
        <text class="send-label">{{chatRequestPending ? '…' : '↑'}}</text>
      </div>
    </div>
  </div>

  <div if="{{subPage === 'answer'}}" class="subpage answer-page">
    <text class="fixed-page-title">语音回答</text>
    <list itemscale="false" itemcenter="false" class="answer-scroll">
      <list-item class="answer-item">
        <div class="answer-user-card">
          <text class="answer-author">你</text>
          <text class="answer-user-text">{{voiceQuestionText || voiceTranscriptText}}</text>
        </div>
      </list-item>
      <list-item class="answer-item">
        <div class="answer-assistant-card">
          <div class="answer-heading">
            <image class="answer-logo" src="/common/interface-icons/openai-white.png"></image>
            <text class="answer-author">NOVA</text>
          </div>
          <text class="answer-assistant-text">{{voiceAnswerText}}</text>
          <text class="answer-silent">手表保持静音 · 文字已完整保存</text>
        </div>
      </list-item>
      <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
    </list>
    <div class="answer-actions">
      <div class="secondary-pill" @click="copyVoiceAnswer">
        <image class="button-icon" src="/common/interface-icons/copy-white.png"></image>
        <text class="pill-label">复制</text>
      </div>
      <div class="primary-pill" @click="continueVoiceChat">
        <image class="button-icon" src="/common/interface-icons/chat-white.png"></image>
        <text class="pill-label">继续追问</text>
      </div>
    </div>
  </div>

  <div if="{{subPage === 'task'}}" class="subpage task-page">
    <text class="fixed-page-title">Codex 任务</text>
    <div class="task-orbit">
      <div class="task-orbit-halo"></div>
      <div class="task-orbit-dash"></div>
      <div class="task-core">
        <image class="task-icon" src="/common/interface-icons/terminal-cyan.png"></image>
      </div>
    </div>
    <div class="task-status-line">
      <text class="task-stage">{{codexStage}}</text>
      <text class="task-elapsed">{{codexElapsedText}}</text>
    </div>
    <text class="task-message">{{codexMessage}}</text>
    <div class="task-card">
      <text class="task-card-label">识别内容</text>
      <text class="task-card-text">{{codexTranscript || recordText || '正在转写语音…'}}</text>
    </div>
    <div if="{{codexError}}" class="task-error-card">
      <text class="task-error-text">{{codexError}}</text>
    </div>
    <div
      if="{{codexStatus !== 'succeeded' && codexStatus !== 'failed' && codexStatus !== 'cancelled'}}"
      class="danger-pill task-stop"
      @click="cancelCodexTask">
      <image class="button-icon" src="/common/interface-icons/stop-red.png"></image>
      <text class="pill-label">停止任务</text>
    </div>
    <text class="page-hint">左滑收起 · PC 任务继续执行</text>
  </div>

  <div if="{{subPage === 'result'}}" class="subpage result-page">
    <text class="fixed-page-title">摘要结果</text>
    <div class="segmented-control">
      <div class="segment-indicator {{resultTab === 'summary' ? 'segment-right' : 'segment-left'}}"></div>
      <div class="segment-option" @click="showTranscript">
        <text class="segment-label {{resultTab === 'transcript' ? 'segment-label-active' : ''}}">转写</text>
      </div>
      <div class="segment-option" @click="showSummary">
        <text class="segment-label {{resultTab === 'summary' ? 'segment-label-active' : ''}}">摘要</text>
      </div>
    </div>
    <div class="result-meta">
      <div class="result-chip">
        <image class="mini-icon" src="/common/interface-icons/check-teal.png"></image>
        <text class="result-chip-text">Codex 已完成</text>
      </div>
      <div class="result-chip result-chip-muted">
        <image class="mini-icon" src="/common/interface-icons/shield-white.png"></image>
        <text class="result-chip-text">只读任务</text>
      </div>
    </div>
    <list itemscale="false" itemcenter="false" class="result-scroll">
      <block if="{{resultTab === 'summary'}}">
        <list-item class="result-list-item" for="{{summaryItems}}">
          <div class="result-point">
            <div class="result-index"><text class="result-index-text">{{$idx + 1}}</text></div>
            <text class="result-point-text">{{$item}}</text>
          </div>
        </list-item>
      </block>
      <block if="{{resultTab === 'transcript'}}">
        <list-item class="result-list-item" @click="beginTranscriptEdit">
          <div class="transcript-card">
            <text class="transcript-text">{{resultTranscriptText || 'Codex 未返回转写内容'}}</text>
            <text class="transcript-edit-hint">{{editingTranscript ? '编辑中' : '点按编辑转写'}}</text>
          </div>
        </list-item>
        <list-item if="{{editingTranscript}}" class="result-list-item">
          <input class="transcript-input" type="text" value="{{editBuffer}}" @change="onTranscriptInput" />
        </list-item>
      </block>
      <list-item class="round-scroll-spacer"><div class="round-spacer-body"></div></list-item>
    </list>
    <div if="{{editingTranscript}}" class="result-actions result-actions-edit">
      <div class="primary-pill" @click="saveTranscript">
        <image class="button-icon" src="/common/interface-icons/check-teal.png"></image>
        <text class="pill-label">保存修改</text>
      </div>
    </div>
    <div if="{{!editingTranscript}}" class="result-actions">
      <div class="secondary-pill" @click="copyResult">
        <image class="button-icon" src="/common/interface-icons/copy-white.png"></image>
        <text class="pill-label">复制</text>
      </div>
      <div class="primary-pill" @click="continueFromResult">
        <image class="button-icon" src="/common/interface-icons/chat-white.png"></image>
        <text class="pill-label">继续追问</text>
      </div>
    </div>
  </div>

  <div if="{{toastVisible}}" class="toast">
    <text class="toast-text">{{toastText}}</text>
  </div>
</div>
